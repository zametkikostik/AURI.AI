APP_ENV=staging
DEBUG=true
AI_MODE=strict_private
SECRET_KEY=change-me-staging-secret-key-min-64-chars-xxxxxxxxxxxxxxxxxxxx
SETTINGS_ENCRYPTION_KEY=change-me-staging-encryption-key
DATABASE_URL=postgresql+asyncpg://auri:auri_staging@postgres:5432/auri_staging
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=auri-staging
QDRANT_HOST=qdrant
OLLAMA_BASE_URL=http://ollama:11434
FRONTEND_URL=https://staging.auri.example.com
OIDC_REDIRECT_BASE=https://staging.auri.example.com
