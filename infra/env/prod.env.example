APP_ENV=production
DEBUG=false
AI_MODE=strict_private
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_64
SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
DATABASE_URL=postgresql+asyncpg://auri:STRONG_PASSWORD@postgres:5432/auri
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=auri-prod
S3_REGION=eu-central-1
QDRANT_HOST=qdrant
OLLAMA_BASE_URL=http://ollama:11434
FRONTEND_URL=https://auri.example.com
OIDC_REDIRECT_BASE=https://auri.example.com
USE_REDIS_RATE_LIMIT=true
RATE_LIMIT_FAIL_CLOSED=false
SENTRY_DSN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ENTERPRISE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@auri.example.com
SMTP_TLS=true
