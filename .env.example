# ======================
# AURI.AI Environment
# ======================

# --- Application ---
APP_NAME=AURI.AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-very-long-random-string-at-least-64-chars
API_V1_PREFIX=/api/v1

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=auri
POSTGRES_PASSWORD=auri_secret
POSTGRES_DB=auri
DATABASE_URL=postgresql+asyncpg://auri:auri_secret@localhost:5432/auri

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Storage (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=auri-meetings
S3_REGION=us-east-1
S3_USE_SSL=false

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=meetings

# --- Ollama (Local AI - Privacy First) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# --- Cloud AI Providers (optional) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
GOOGLE_API_KEY=

AI_MODE=strict_private

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT__WS_URL=ws://localhost:8000

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=http://localhost:3000

# --- OIDC ---
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_CLIENT_ID=
MICROSOFT_OIDC_CLIENT_SECRET=
OKTA_DOMAIN=
OKTA_OIDC_CLIENT_ID=
OKTA_OIDC_CLIENT_SECRET=
OIDC_REDIRECT_BASE=http://localhost:8000

# --- Security ---
SETTINGS_ENCRYPTION_KEY=
USE_REDIS_RATE_LIMIT=true
RATE_LIMIT_FAIL_CLOSED=false

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ENTERPRISE=

# --- Diarization ---
HF_TOKEN=

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=auri-backend
